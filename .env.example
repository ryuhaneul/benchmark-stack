# Database Configuration
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=testdb
MYSQL_USER=testuser
MYSQL_PASSWORD=testpassword

# Application Configuration
NODE_ENV=production

# Domain Configuration
DOMAIN=localhost
ACME_EMAIL=your-email@example.com

# Let's Encrypt Configuration
# Set to 'true' to use Let's Encrypt (requires valid domain and DNS setup)
# Set to 'false' to use self-signed certificate (default)
USE_LETSENCRYPT=false

# ACME DNS Configuration (for DNS-01 challenge)
# Set to 'true' to enable acme-dns (for wildcard certificates)
USE_ACME_DNS=false
ACME_DNS_API_URL=http://acme-dns:8080
# These are set after registering with acme-dns
# ACME_DNS_USERNAME=your-acme-dns-username
# ACME_DNS_PASSWORD=your-acme-dns-password
